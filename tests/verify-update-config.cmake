file(READ "${APP_PLIST}" contents)
if(NOT contents MATCHES "<key>NVManualDownloadURL</key>[ \t\r\n]*<string>https://github.com/[^<]+/releases/latest/download/NestView-macOS-AppleSilicon.dmg</string>")
    message(FATAL_ERROR "A direct installer download URL is required")
endif()
if(NOT contents MATCHES "<key>CFBundleIdentifier</key>[ \t\r\n]*<string>org.nestview.viewer</string>")
    message(FATAL_ERROR "Unexpected app bundle identifier")
endif()
foreach(flag SUVerifyUpdateBeforeExtraction SURequireSignedFeed)
    if(NOT contents MATCHES "<key>${flag}</key>[ \t\r\n]*<true/>")
        message(FATAL_ERROR "${flag} must be enabled")
    endif()
endforeach()
foreach(flag SUAllowsAutomaticUpdates SUAutomaticallyUpdate SUSendProfileInfo)
    if(NOT contents MATCHES "<key>${flag}</key>[ \t\r\n]*<false/>")
        message(FATAL_ERROR "${flag} must be disabled")
    endif()
endforeach()
if(contents MATCHES "github.com/[Jj]urplel/")
    message(FATAL_ERROR "The fork must not use upstream qView updates")
endif()
if(NOT contents MATCHES "<key>CFBundleDisplayName</key>[ \t\r\n]*<string>NestView</string>")
    message(FATAL_ERROR "Unexpected app display name")
endif()
if(NOT contents MATCHES "<key>SUPublicEDKey</key>[ \t\r\n]*<string>[A-Za-z0-9/+=]+</string>")
    message(FATAL_ERROR "A public update signing key is required")
endif()
